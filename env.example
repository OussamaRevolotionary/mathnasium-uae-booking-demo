# Copy this file to  .env.local  (never committed) and add ONE key to connect the assistant to a real AI model.
# Without a key the assistant uses its built-in answers.

# Google Gemini — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# or NVIDIA — key from https://build.nvidia.com
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
